[Unit]
Description=Next.js Next Bus App
After=network.target

[Service]
Type=simple
# Set the user that should run the service (change this to your deploy user)
User=youruser
Group=www-data

# WorkingDirectory must point to the project root where package.json and .next live
WorkingDirectory=/home/youruser/next-bus-app

# Optional environment file with NODE_ENV and PORT
EnvironmentFile=/home/youruser/next-bus-app/deploy/env.production

# Use node to run the local next binary to avoid relying on npm in PATH
ExecStart=/usr/bin/node ./node_modules/next/dist/bin/next start -p ${PORT}

Restart=on-failure
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
