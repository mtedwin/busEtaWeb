[Unit]
Description=Next.js Next Bus App
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

WorkingDirectory=/app/BusWeb

Environment=NODE_ENV=production
Environment=PORT=3000

ExecStart=/usr/bin/node /app/BusWeb/server.js

Restart=on-failure
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
